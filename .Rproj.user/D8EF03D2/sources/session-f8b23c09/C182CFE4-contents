library(survival)
set.seed(123)
n <- 4000
# Simulate a 4-category cross-classified exposure variable
# i   = normal-weight, lower bilirubin   (reference)
# ii  = normal-weight, higher bilirubin
# iii = overweight/obese, lower bilirubin
# iv  = overweight/obese, higher bilirubin
group <- factor(sample(c("i", "ii", "iii", "iv"), n, replace = TRUE),
levels = c("i", "ii", "iii", "iv"))
true_loghr <- c(i = 0, ii = 0.10, iii = 0.30, iv = 0.55)
lp <- true_loghr[as.character(group)]
time <- rexp(n, rate = 0.05 * exp(lp))
status <- rep(1, n)
dat <- data.frame(time, status, group)
## --- Approach 1: Wald test via contrast on the original model ---------
fit_orig <- coxph(Surv(time, status) ~ group, data = dat)
co <- coef(fit_orig)
vc <- vcov(fit_orig)
b3 <- co["groupiii"]
b4 <- co["groupiv"]
v3 <- vc["groupiii", "groupiii"]
v4 <- vc["groupiv", "groupiv"]
cov34 <- vc["groupiii", "groupiv"]
wald_stat <- (b4 - b3)^2 / (v3 + v4 - 2 * cov34)
p_wald <- pchisq(wald_stat, df = 1, lower.tail = FALSE)
## --- Approach 2: Relevel so group iii is the new reference -------------
dat$group_relevel <- relevel(dat$group, ref = "iii")
fit_relevel <- coxph(Surv(time, status) ~ group_relevel, data = dat)
p_relevel <- summary(fit_relevel)$coefficients["group_releveliv", "Pr(>|z|)"]
## --- Compare --------------------------------------------------------------
cat("Wald contrast p-value:   ", p_wald, "\n")
cat("Releveled model p-value: ", p_relevel, "\n")
cat("Difference:              ", abs(p_wald - p_relevel), "\n")

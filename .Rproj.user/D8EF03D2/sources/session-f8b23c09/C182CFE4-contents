# 14) Test the IIA assumption using the Hausman-McFadden test
# ------------------------------------------------------------------------------
# The multinomial logit model assumes independence of irrelevant alternatives
# This means that the relative odds of two outcome categories should not depend
# on whether another outcome category is included in the choice set
# Example:
# The relative odds of being a Carnivore rather than a Flexitarian
# should not depend strongly on whether Vegetarians are included as another option
# The Hausman-McFadden test compares two models
# First, the multinomial model is estimated with all outcome categories
# Second, the model is re-estimated after removing one outcome category
# H0: The IIA assumption holds
# H1: The IIA assumption is violated
# p > .05: no strong evidence against IIA
# p < .05: evidence that IIA may be violated
# Install once if needed
# install.packages("mlogit")
library(mlogit)
# Prepare data for mlogit
vegan_mlogit_input <- vegan %>%
mutate(
diet_type_vegetarian_base = relevel(diet_type, ref = "Vegetarians"),
diet_type_carnivore_base = relevel(diet_type, ref = "Carnivores")
)
# Convert data to mlogit format
vegan_mlogit_veg <- mlogit.data(
vegan_mlogit_input,
choice = "diet_type_vegetarian_base",
shape = "wide"
)
# Re-estimate the multinomial model using mlogit
# Individual-specific predictors are entered after |
m3_mlogit_veg <- mlogit(
diet_type_vegetarian_base ~ 1 |
canteen_use +
threat_climate +
gender_fac +
age +
hhincome,
data = vegan_mlogit_veg,
reflevel = "Vegetarians"
)
summary(m3_mlogit_veg)
# Remove Carnivores and compare Vegetarians with Flexitarians
iia_no_carnivores <- hmftest(
m3_mlogit_veg,
c("Vegetarians", "Flexitarians")
)
iia_no_carnivores
